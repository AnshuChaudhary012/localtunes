{
  "name": "LocalTunes - Offline Music Player",
  "short_name": "LocalTunes",
  "description": "Production-quality client-side local music player with offline storage, playlists, and rich audio controls.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["music", "audio", "entertainment", "utilities"],
  "shortcuts": [
    {
      "name": "Library",
      "url": "/#library",
      "description": "Browse your music library"
    },
    {
      "name": "Favorites",
      "url": "/#favorites",
      "description": "Listen to your favorite tracks"
    },
    {
      "name": "Playlists",
      "url": "/#playlists",
      "description": "Manage your playlists"
    }
  ]
}
